generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  customer
  admin
}

enum DesignStatus {
  draft
  saved
  ordered
}

enum ElementType {
  image
  text
}

enum TextAlign {
  left
  center
  right
}

enum OrderStatus {
  pending
  paid
  processing
  printing
  shipped
  delivered
  cancelled
  refunded
}

enum PaymentStatus {
  pending
  succeeded
  failed
}

enum RefundStatus {
  requested
  approved
  rejected
  completed
}

enum DiscountType {
  percent
  fixed
}

enum NotificationChannel {
  email
  sms
  in_app
}

enum StockReason {
  order
  restock
  adjustment
  refund
}

model User {
  id              BigInt    @id @default(autoincrement())
  name            String    @db.VarChar(100)
  email           String    @unique @db.VarChar(150)
  googleId        String?   @unique @map("google_id") @db.VarChar(255)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  role            UserRole  @default(customer)
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  addresses      Address[]
  passwordResets PasswordReset[]
  designs        Design[]
  carts          Cart[]
  orders         Order[]
  paymentMethods PaymentMethod[]
  reviews        Review[]
  wishlists      Wishlist[]
  notifications  Notification[]

  @@map("users")
}

model Address {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  label      String?  @db.VarChar(50)
  fullName   String   @map("full_name") @db.VarChar(100)
  phone      String   @db.VarChar(20)
  line1      String   @db.VarChar(255)
  line2      String?  @db.VarChar(255)
  city       String   @db.VarChar(100)
  province   String   @db.VarChar(100)
  postalCode String   @map("postal_code") @db.VarChar(20)
  country    String   @db.VarChar(100)
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingOrders Order[] @relation("ShippingAddress")
  billingOrders  Order[] @relation("BillingAddress")

  @@index([userId])
  @@map("addresses")
}

model PasswordReset {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model Category {
  id        BigInt     @id @default(autoincrement())
  name      String     @db.VarChar(100)
  slug      String     @unique @db.VarChar(100)
  parentId  BigInt?    @map("parent_id")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryToCategory")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id          BigInt   @id @default(autoincrement())
  categoryId  BigInt   @map("category_id")
  name        String   @db.VarChar(150)
  slug        String   @unique @db.VarChar(150)
  description String?
  basePrice   Decimal  @map("base_price") @db.Decimal(10, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category        Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants        ProductVariant[]
  images          ProductImage[]
  printableAreas  PrintableArea[]
  designs         Design[]
  reviews         Review[]
  mockupTemplates ProductMockupTemplate[]

  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id            BigInt   @id @default(autoincrement())
  productId     BigInt   @map("product_id")
  color         String   @db.VarChar(50)
  size          String   @db.VarChar(20)
  sku           String   @unique @db.VarChar(100)
  priceOverride Decimal? @map("price_override") @db.Decimal(10, 2)
  stockQuantity Int      @default(0) @map("stock_quantity")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  images         ProductImage[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  wishlists      Wishlist[]
  stockMovements StockMovement[]
  mockupTemplates ProductMockupTemplate[]

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        BigInt   @id @default(autoincrement())
  productId BigInt   @map("product_id")
  variantId BigInt?  @map("variant_id")
  imageUrl  String   @map("image_url") @db.VarChar(255)
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
  @@map("product_images")
}

model PrintableArea {
  id        BigInt   @id @default(autoincrement())
  productId BigInt   @map("product_id")
  name      String   @db.VarChar(50)
  x         Int
  y         Int
  width     Int
  height    Int
  createdAt DateTime @default(now()) @map("created_at")

  product         Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  designElements  DesignElement[]
  designSnapshots DesignSnapshot[]
  mockupTemplates ProductMockupTemplate[]

  @@index([productId])
  @@map("printable_areas")
}

model Design {
  id        BigInt       @id @default(autoincrement())
  userId    BigInt       @map("user_id")
  productId BigInt       @map("product_id")
  name      String       @db.VarChar(100)
  status    DesignStatus @default(draft)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  elements  DesignElement[]
  snapshots DesignSnapshot[]
  cartItems CartItem[]

  @@index([userId])
  @@index([productId])
  @@map("designs")
}

model DesignElement {
  id              BigInt      @id @default(autoincrement())
  designId        BigInt      @map("design_id")
  printableAreaId BigInt      @map("printable_area_id")
  type            ElementType
  layerOrder      Int         @map("layer_order")
  posX            Float       @map("pos_x")
  posY            Float       @map("pos_y")
  width           Float
  height          Float
  rotation        Float       @default(0)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  design        Design              @relation(fields: [designId], references: [id], onDelete: Cascade)
  printableArea PrintableArea       @relation(fields: [printableAreaId], references: [id], onDelete: Restrict)
  image         DesignElementImage?
  text          DesignElementText?

  @@index([designId])
  @@index([printableAreaId])
  @@map("design_elements")
}

model DesignElementImage {
  id               BigInt   @id @default(autoincrement())
  designElementId  BigInt   @unique @map("design_element_id")
  fileUrl          String   @map("file_url") @db.VarChar(255)
  originalFilename String   @map("original_filename") @db.VarChar(255)
  mimeType         String   @map("mime_type") @db.VarChar(50)
  widthPx          Int      @map("width_px")
  heightPx         Int      @map("height_px")
  createdAt        DateTime @default(now()) @map("created_at")

  designElement DesignElement @relation(fields: [designElementId], references: [id], onDelete: Cascade)

  @@map("design_element_images")
}

model DesignElementText {
  id              BigInt    @id @default(autoincrement())
  designElementId BigInt    @unique @map("design_element_id")
  content         String
  fontFamily      String    @map("font_family") @db.VarChar(100)
  fontSize        Int       @map("font_size")
  color           String    @db.VarChar(20)
  bold            Boolean   @default(false)
  italic          Boolean   @default(false)
  align           TextAlign @default(left)
  createdAt       DateTime  @default(now()) @map("created_at")

  designElement DesignElement @relation(fields: [designElementId], references: [id], onDelete: Cascade)

  @@map("design_element_text")
}

model DesignSnapshot {
  id              BigInt   @id @default(autoincrement())
  designId        BigInt   @map("design_id")
  printableAreaId BigInt   @map("printable_area_id")
  mockupImageUrl  String   @map("mockup_image_url") @db.VarChar(255)
  elementsJson    Json     @map("elements_json")
  createdAt       DateTime @default(now()) @map("created_at")

  design        Design        @relation(fields: [designId], references: [id], onDelete: Cascade)
  printableArea PrintableArea @relation(fields: [printableAreaId], references: [id], onDelete: Restrict)
  orderItems    OrderItem[]

  @@index([designId])
  @@map("design_snapshots")
}

model Cart {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt?  @map("user_id")
  sessionId String?  @map("session_id") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId])
  @@map("carts")
}

model CartItem {
  id               BigInt   @id @default(autoincrement())
  cartId           BigInt   @map("cart_id")
  productVariantId BigInt   @map("product_variant_id")
  designId         BigInt?  @map("design_id")
  quantity         Int
  unitPrice        Decimal  @map("unit_price") @db.Decimal(10, 2)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  design  Design?        @relation(fields: [designId], references: [id], onDelete: SetNull)

  @@index([cartId])
  @@index([productVariantId])
  @@map("cart_items")
}

model Order {
  id                BigInt      @id @default(autoincrement())
  userId            BigInt      @map("user_id")
  orderNumber       String      @unique @map("order_number") @db.VarChar(30)
  status            OrderStatus @default(pending)
  subtotal          Decimal     @db.Decimal(10, 2)
  discountTotal     Decimal     @default(0) @map("discount_total") @db.Decimal(10, 2)
  shippingTotal     Decimal     @map("shipping_total") @db.Decimal(10, 2)
  taxTotal          Decimal     @default(0) @map("tax_total") @db.Decimal(10, 2)
  grandTotal        Decimal     @map("grand_total") @db.Decimal(10, 2)
  shippingAddressId BigInt      @map("shipping_address_id")
  billingAddressId  BigInt      @map("billing_address_id")
  placedAt          DateTime    @map("placed_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  user              User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  shippingAddress   Address              @relation("ShippingAddress", fields: [shippingAddressId], references: [id], onDelete: Restrict)
  billingAddress    Address              @relation("BillingAddress", fields: [billingAddressId], references: [id], onDelete: Restrict)
  items             OrderItem[]
  statusHistory     OrderStatusHistory[]
  shipments         Shipment[]
  payments          Payment[]
  refunds           Refund[]
  couponRedemptions CouponRedemption[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id               BigInt   @id @default(autoincrement())
  orderId          BigInt   @map("order_id")
  productVariantId BigInt   @map("product_variant_id")
  designSnapshotId BigInt?  @map("design_snapshot_id")
  productName      String   @map("product_name") @db.VarChar(150)
  variantLabel     String   @map("variant_label") @db.VarChar(100)
  quantity         Int
  unitPrice        Decimal  @map("unit_price") @db.Decimal(10, 2)
  lineTotal        Decimal  @map("line_total") @db.Decimal(10, 2)
  createdAt        DateTime @default(now()) @map("created_at")

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant        ProductVariant  @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  designSnapshot DesignSnapshot? @relation(fields: [designSnapshotId], references: [id], onDelete: SetNull)
  reviews        Review[]        @relation("OrderItemReviews")
  refundItems    RefundItem[]

  @@index([orderId])
  @@index([productVariantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        BigInt      @id @default(autoincrement())
  orderId   BigInt      @map("order_id")
  status    OrderStatus
  note      String?     @db.VarChar(255)
  changedBy BigInt?     @map("changed_by")
  createdAt DateTime    @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

model Shipment {
  id                 BigInt    @id @default(autoincrement())
  orderId            BigInt    @map("order_id")
  carrier            String    @db.VarChar(100)
  trackingNumber     String    @map("tracking_number") @db.VarChar(150)
  shippedAt          DateTime? @map("shipped_at")
  deliveredAt        DateTime? @map("delivered_at")
  estimatedDelivery  DateTime? @map("estimated_delivery") @db.Date
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("shipments")
}

model Payment {
  id                  BigInt        @id @default(autoincrement())
  orderId             BigInt        @map("order_id")
  gateway             String        @db.VarChar(50)
  transactionRef      String        @map("transaction_ref") @db.VarChar(255)
  gatewayPaymentId    String?       @map("gateway_payment_id") @db.VarChar(255)
  amount              Decimal       @db.Decimal(10, 2)
  status              PaymentStatus @default(pending)
  paidAt              DateTime?     @map("paid_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([orderId])
  @@map("payments")
}

model PaymentMethod {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  gateway   String   @db.VarChar(50)
  token     String   @db.VarChar(255)
  brand     String?  @db.VarChar(30)
  last4     String?  @db.VarChar(4)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payment_methods")
}

model Refund {
  id          BigInt       @id @default(autoincrement())
  orderId     BigInt       @map("order_id")
  paymentId   BigInt       @map("payment_id")
  amount      Decimal      @db.Decimal(10, 2)
  reason      String?      @db.VarChar(255)
  status      RefundStatus @default(requested)
  requestedBy BigInt       @map("requested_by")
  processedAt DateTime?    @map("processed_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  order   Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  items   RefundItem[]

  @@index([orderId])
  @@index([paymentId])
  @@map("refunds")
}

model RefundItem {
  id          BigInt  @id @default(autoincrement())
  refundId    BigInt  @map("refund_id")
  orderItemId BigInt  @map("order_item_id")
  quantity    Int
  amount      Decimal @db.Decimal(10, 2)

  refund    Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([refundId])
  @@index([orderItemId])
  @@map("refund_items")
}

model Coupon {
  id                BigInt       @id @default(autoincrement())
  code              String       @unique @db.VarChar(50)
  discountType      DiscountType @map("discount_type")
  value             Decimal      @db.Decimal(10, 2)
  minOrderAmount    Decimal?     @map("min_order_amount") @db.Decimal(10, 2)
  usageLimit        Int?         @map("usage_limit")
  usageLimitPerUser Int?         @map("usage_limit_per_user")
  startsAt          DateTime?    @map("starts_at")
  expiresAt         DateTime?    @map("expires_at")
  isActive          Boolean      @default(true) @map("is_active")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  redemptions CouponRedemption[]

  @@map("coupons")
}

model CouponRedemption {
  id        BigInt   @id @default(autoincrement())
  couponId  BigInt   @map("coupon_id")
  userId    BigInt   @map("user_id")
  orderId   BigInt   @map("order_id")
  createdAt DateTime @default(now()) @map("created_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
  @@map("coupon_redemptions")
}

model Review {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt   @map("user_id")
  productId   BigInt   @map("product_id")
  orderItemId BigInt?  @map("order_item_id")
  rating      Int
  comment     String?
  isApproved  Boolean  @default(false) @map("is_approved")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItem OrderItem?    @relation("OrderItemReviews", fields: [orderItemId], references: [id], onDelete: SetNull)
  images    ReviewImage[]

  @@index([userId])
  @@index([productId])
  @@map("reviews")
}

model ReviewImage {
  id        BigInt   @id @default(autoincrement())
  reviewId  BigInt   @map("review_id")
  imageUrl  String   @map("image_url") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_images")
}

model Wishlist {
  id               BigInt   @id @default(autoincrement())
  userId           BigInt   @map("user_id")
  productVariantId BigInt   @map("product_variant_id")
  createdAt        DateTime @default(now()) @map("created_at")

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([userId, productVariantId])
  @@map("wishlists")
}

model Notification {
  id          BigInt              @id @default(autoincrement())
  userId      BigInt              @map("user_id")
  type        String              @db.VarChar(50)
  channel     NotificationChannel
  message     String
  relatedType String?             @map("related_type") @db.VarChar(50)
  relatedId   BigInt?             @map("related_id")
  readAt      DateTime?           @map("read_at")
  createdAt   DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model StockMovement {
  id               BigInt      @id @default(autoincrement())
  productVariantId BigInt      @map("product_variant_id")
  changeQty        Int         @map("change_qty")
  reason           StockReason
  referenceId      BigInt?     @map("reference_id")
  createdBy        BigInt?     @map("created_by")
  createdAt        DateTime    @default(now()) @map("created_at")

  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([productVariantId])
  @@map("stock_movements")
}

model ProductMockupTemplate {
  id                 BigInt   @id @default(autoincrement())
  productId          BigInt   @map("product_id")
  printableAreaId    BigInt   @map("printable_area_id")
  variantId          BigInt?  @map("variant_id")
  baseImageUrl       String   @map("base_image_url") @db.VarChar(255)
  displacementMapUrl String?  @map("displacement_map_url") @db.VarChar(255)
  lightingMapUrl     String?  @map("lighting_map_url") @db.VarChar(255)
  perspectiveConfig  Json?    @map("perspective_config")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  printableArea PrintableArea @relation(fields: [printableAreaId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([printableAreaId])
  @@index([variantId])
  @@unique([printableAreaId, variantId])
  @@map("product_mockup_templates")
}